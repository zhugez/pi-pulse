{
  "name": "pi-pulse",
  "version": "1.0.0",
  "description": "A growing collection of crafted extensions for Pi Coding Agent",
  "type": "module",
  "author": "zhugez",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhugez/pi-pulse.git"
  },
  "homepage": "https://github.com/zhugez/pi-pulse#readme",
  "bugs": {
    "url": "https://github.com/zhugez/pi-pulse/issues"
  },
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "pi-extension",
    "antigravity",
    "gemini",
    "llm-provider",
    "llm-usage",
    "throughput",
    "ponytail"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "test": "bash scripts/test.sh",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "pi": {
    "extensions": [
      "./extensions/startup-entry.ts",
      "./node_modules/pi-antigravity/src/index.ts",
      "./node_modules/@dietrichgebert/ponytail/pi-extension/index.js"
    ],
    "skills": [
      "./node_modules/@dietrichgebert/ponytail/skills"
    ]
  },
  "license": "MIT",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.0",
    "@earendil-works/pi-tui": ">=0.80.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "^0.87.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@dietrichgebert/ponytail": "4.12.0",
    "pi-antigravity": "0.8.0"
  },
  "bundleDependencies": [
    "pi-antigravity",
    "@dietrichgebert/ponytail"
  ]
}
